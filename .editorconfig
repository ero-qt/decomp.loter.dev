root = true

# All files
[*]
charset              = utf-8
insert_final_newline = true

indent_style             = space
trim_trailing_whitespace = true

# Code files
[*.{css,html,java,js,ts}]
max_line_length = 150

# Other markup files
[*.{html,json,xml,yml}]
indent_size = 2
tab_width   = 2

# Markdown files
[*.md]
indent_size              = 2
tab_width                = 2
trim_trailing_whitespace = false
