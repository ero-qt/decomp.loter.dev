{
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    ".gitignore": ".gitattributes, .gitmodules",
    "readme.md": "changelog.md, license.md, third-party-notices.md",
    "package.json": ".editorconfig, bun.lock, tsconfig.json, justfile",
    "*.ts": "${capture}.test.ts, ${capture}-*.test.ts, ${capture}.perf.ts",
    "*.sh": "${capture}.test.ts, ${capture}.service, ${capture}.timer",
    "*.css": "${capture}.test.ts",
  },
  "files.exclude": {
    "artifacts/": true,
    "node_modules/": true,
  },
}
