{
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    ".gitignore": ".gitattributes, .editorconfig",
    "readme.md": "license.md",
    "package.json": "bun.lock, tsconfig.json, justfile",
    // leaves editor-testing.ts and page-testing.ts at the top because many test files share them
    "*.ts": "${capture}.test.ts, ${capture}-*.test.ts, ${capture}.perf.ts, ${capture}-testing.ts",
  },
  "files.exclude": {
    "artifacts/": true,
    "node_modules/": true,
  },
}
