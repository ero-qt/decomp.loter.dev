<Project>

  <!-- puts obj, bin and publish in the repo's ignored artifacts folder, so no build file sits beside the sources. -->
  <PropertyGroup>
    <ArtifactsPath>$(MSBuildThisFileDirectory)/../../artifacts/dotnet</ArtifactsPath>
  </PropertyGroup>

  <!-- skips the vulnerability audit because it fetches its data from nuget.org on every restore. -->
  <PropertyGroup>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <!-- fails the build on the style warnings of the repo's .editorconfig too. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- keeps the published bytes the same for the same sources, SDK and packages. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
