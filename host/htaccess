# sends the site's headers with every answer of Apache, also with a missing file
Header always set Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'"
Header always set Referrer-Policy "no-referrer"
Header always set X-Content-Type-Options "nosniff"

# sends the types that the browser checks, because it only compiles WebAssembly and imports a module with them
AddType application/wasm .wasm
AddType text/javascript .mjs

# keeps the host from running code that an upload slipped into the site, because the site only has static files
Options -ExecCGI -Includes -Indexes
<FilesMatch "(?i)\.(php[3-8]?|phtml|phar|pht|cgi|pl|py|sh|shtml|inc)$">
    SetHandler none
    Require all denied
</FilesMatch>

# marks each file with a fingerprint in its name: Vite's assets, the .NET framework's files and Bun's chunks
SetEnvIf Request_URI "^/assets/" long_cache
SetEnvIf Request_URI "^/engines/dotnet/_framework/[^/]+\.[a-z0-9]{10}\.(js|wasm)$" long_cache
SetEnvIf Request_URI "^/engines/[^/]+/[^/]+-[a-z0-9]{8}\.js$" long_cache

# keeps each marked file for a year and lets browsers ask again for each other file. Sends the cache header only with
# a found file, because a missing file in assets/ mustn't stay cached for a year. Doesn't use `<If>`, because
# Apache drops the `always` headers above for each request that matches one.
Header set Cache-Control "public, max-age=31536000, immutable" env=long_cache
Header set Cache-Control "no-cache" env=!long_cache
