{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "IL Assembly",
  "scopeName": "source.il",
  "fileTypes": ["il"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#comment-block" },
    { "include": "#string-double" },
    { "include": "#string-single" },
    { "include": "#bytearray" },
    { "include": "#blob" },
    { "include": "#directive" },
    { "include": "#label" },
    { "include": "#opcode-prefix" },
    { "include": "#branch" },
    { "include": "#switch" },
    { "include": "#opcode-control" },
    { "include": "#opcode" },
    { "include": "#storage-modifier" },
    { "include": "#type-builtin" },
    { "include": "#type-builtin-ilspy" },
    { "include": "#constant-language" },
    { "include": "#keyword-other" },
    { "include": "#handler" },
    { "include": "#number-hex" },
    { "include": "#number-float" },
    { "include": "#number-integer" },
    { "include": "#assembly-ref" },
    { "include": "#punctuation" }
  ],
  "repository": {

    "comment": {
      "name": "comment.line.double-slash.il",
      "match": "//.*$"
    },

    "comment-block": {
      "name": "comment.block.il",
      "begin": "/\\*",
      "end": "\\*/"
    },

    "string-double": {
      "name": "string.quoted.double.il",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.il" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.il" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.il",
          "match": "\\\\."
        }
      ]
    },

    "string-single": {
      "name": "string.quoted.single.il",
      "begin": "'",
      "end": "'",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.il" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.il" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.il",
          "match": "\\\\."
        }
      ]
    },

    "bytearray": {
      "begin": "\\b(bytearray)\\s*(\\()",
      "beginCaptures": {
        "1": { "name": "keyword.other.bytearray.il" },
        "2": { "name": "punctuation.section.parens.begin.il" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.section.parens.end.il" }
      },
      "patterns": [
        { "include": "#comment" },
        {
          "name": "constant.numeric.hex.il",
          "match": "[0-9a-fA-F]{2}"
        }
      ]
    },

    "blob": {
      "begin": "(=)\\s*(\\()",
      "beginCaptures": {
        "1": { "name": "keyword.operator.assignment.il" },
        "2": { "name": "punctuation.section.parens.begin.il" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.section.parens.end.il" }
      },
      "patterns": [
        { "include": "#comment" },
        {
          "name": "constant.numeric.hex.il",
          "match": "\\b[0-9a-fA-F]{2}\\b"
        }
      ]
    },

    "directive": {
      "patterns": [
        {
          "name": "keyword.other.directive.il",
          "match": "(?<![.\\w])\\.(assembly|module|class|namespace|method|field|property|event|custom)(?![.\\w])"
        },
        {
          "name": "keyword.other.directive.il",
          "match": "(?<![.\\w])\\.(maxstack|locals|entrypoint|try|catch|finally|filter|fault|override)(?![.\\w])"
        },
        {
          "name": "keyword.other.directive.il",
          "match": "(?<![.\\w])\\.(data|size|pack|param|permissionset|zeroinit|emitbyte)(?![.\\w])"
        },
        {
          "name": "keyword.other.directive.il",
          "match": "(?<![.\\w])\\.(get|set|addon|removeon|fire|other)(?![.\\w])"
        },
        {
          "name": "keyword.other.directive.il",
          "match": "(?<![.\\w])\\.(export|vtfixup|vtentry|corflags|subsystem|imagebase|stackreserve|file|hash|mresource)(?![.\\w])"
        },
        {
          "name": "keyword.other.directive.il",
          "match": "(?<![.\\w])\\.(line|language|ctor|cctor|ver|publickey|publickeytoken|culture|locale)(?![.\\w])"
        },
        {
          "name": "keyword.other.directive.il",
          "match": "(?<![.\\w])\\.(interfaceimpl|permission|import|pdirect|manifestres|localized)(?![.\\w])"
        }
      ]
    },

    "label": {
      "match": "^\\s*([A-Za-z_$][A-Za-z_$0-9]*)\\s*(:)(?!:)",
      "captures": {
        "1": { "name": "entity.name.label.il" },
        "2": { "name": "punctuation.separator.label.il" }
      }
    },

    "opcode-prefix": {
      "name": "keyword.other.prefix.il",
      "match": "(?<![.\\w])(?:tail|volatile|unaligned|readonly|constrained|no)\\."
    },

    "branch": {
      "patterns": [
        {
          "match": "(?<![.\\w])((?:br|brfalse|brtrue|beq|bge|bgt|ble|blt|leave)(?:\\.s)?)\\s+([A-Za-z_$][A-Za-z_$0-9]*)",
          "captures": {
            "1": { "name": "keyword.control.flow.il" },
            "2": { "name": "entity.name.label.il" }
          }
        },
        {
          "match": "(?<![.\\w])((?:bne|bge|bgt|ble|blt)\\.un(?:\\.s)?)\\s+([A-Za-z_$][A-Za-z_$0-9]*)",
          "captures": {
            "1": { "name": "keyword.control.flow.il" },
            "2": { "name": "entity.name.label.il" }
          }
        }
      ]
    },

    "switch": {
      "begin": "(?<![.\\w])(switch)\\s*(\\()",
      "beginCaptures": {
        "1": { "name": "keyword.control.flow.il" },
        "2": { "name": "punctuation.section.parens.begin.il" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.section.parens.end.il" }
      },
      "patterns": [
        {
          "name": "entity.name.label.il",
          "match": "[A-Za-z_$][A-Za-z_$0-9]*"
        }
      ]
    },

    "opcode-control": {
      "patterns": [
        {
          "name": "keyword.control.flow.il",
          "match": "(?<![.\\w])(?:br|br\\.s|brfalse|brfalse\\.s|brtrue|brtrue\\.s)(?![.\\w])"
        },
        {
          "name": "keyword.control.flow.il",
          "match": "(?<![.\\w])(?:beq|beq\\.s|bge|bge\\.s|bge\\.un|bge\\.un\\.s|bgt|bgt\\.s|bgt\\.un|bgt\\.un\\.s)(?![.\\w])"
        },
        {
          "name": "keyword.control.flow.il",
          "match": "(?<![.\\w])(?:ble|ble\\.s|ble\\.un|ble\\.un\\.s|blt|blt\\.s|blt\\.un|blt\\.un\\.s|bne\\.un|bne\\.un\\.s)(?![.\\w])"
        },
        {
          "name": "keyword.control.flow.il",
          "match": "(?<![.\\w])(?:switch|call|calli|callvirt|ret|jmp)(?![.\\w])"
        },
        {
          "name": "keyword.control.flow.il",
          "match": "(?<![.\\w])(?:throw|rethrow|leave|leave\\.s|endfinally|endfilter|endfault)(?![.\\w])"
        }
      ]
    },

    "opcode": {
      "patterns": [
        {
          "name": "support.function.opcode.il",
          "match": "(?<![.\\w])(?:ldarg|ldarg\\.[0-3s]|ldarga|ldarga\\.s|ldloc|ldloc\\.[0-3s]|ldloca|ldloca\\.s)(?![.\\w])"
        },
        {
          "name": "support.function.opcode.il",
          "match": "(?<![.\\w])(?:ldc\\.i4|ldc\\.i4\\.[0-8]|ldc\\.i4\\.m1|ldc\\.i4\\.s|ldc\\.i8|ldc\\.r4|ldc\\.r8|ldstr|ldnull)(?![.\\w])"
        },
        {
          "name": "support.function.opcode.il",
          "match": "(?<![.\\w])(?:ldfld|ldsfld|ldflda|ldsflda|ldlen|ldobj|ldftn|ldvirtftn|ldtoken)(?![.\\w])"
        },
        {
          "name": "support.function.opcode.il",
          "match": "(?<![.\\w])(?:ldelem|ldelem\\.i[1248]?|ldelem\\.u[1248]|ldelem\\.r[48]|ldelem\\.ref|ldelema)(?![.\\w])"
        },
        {
          "name": "support.function.opcode.il",
          "match": "(?<![.\\w])(?:ldind\\.i[1248]?|ldind\\.u[1248]|ldind\\.r[48]|ldind\\.ref)(?![.\\w])"
        },
        {
          "name": "support.function.opcode.il",
          "match": "(?<![.\\w])(?:starg|starg\\.s|stloc|stloc\\.[0-3s]|stfld|stsfld|stobj)(?![.\\w])"
        },
        {
          "name": "support.function.opcode.il",
          "match": "(?<![.\\w])(?:stelem|stelem\\.i[1248]?|stelem\\.r[48]|stelem\\.ref)(?![.\\w])"
        },
        {
          "name": "support.function.opcode.il",
          "match": "(?<![.\\w])(?:stind\\.i[1248]?|stind\\.r[48]|stind\\.ref)(?![.\\w])"
        },
        {
          "name": "support.function.opcode.il",
          "match": "(?<![.\\w])(?:add|add\\.ovf|add\\.ovf\\.un|sub|sub\\.ovf|sub\\.ovf\\.un|mul|mul\\.ovf|mul\\.ovf\\.un|div|div\\.un|rem|rem\\.un|neg)(?![.\\w])"
        },
        {
          "name": "support.function.opcode.il",
          "match": "(?<![.\\w])(?:and|or|xor|not|shl|shr|shr\\.un)(?![.\\w])"
        },
        {
          "name": "support.function.opcode.il",
          "match": "(?<![.\\w])(?:conv\\.i[1248]?|conv\\.u[1248]?|conv\\.r[48]|conv\\.r\\.un)(?![.\\w])"
        },
        {
          "name": "support.function.opcode.il",
          "match": "(?<![.\\w])(?:conv\\.ovf\\.i[1248]?|conv\\.ovf\\.i[1248]?\\.un|conv\\.ovf\\.u[1248]?|conv\\.ovf\\.u[1248]?\\.un)(?![.\\w])"
        },
        {
          "name": "support.function.opcode.il",
          "match": "(?<![.\\w])(?:ceq|cgt|cgt\\.un|clt|clt\\.un|ckfinite)(?![.\\w])"
        },
        {
          "name": "support.function.opcode.il",
          "match": "(?<![.\\w])(?:newobj|newarr|initobj|castclass|isinst|box|unbox|unbox\\.any|sizeof)(?![.\\w])"
        },
        {
          "name": "support.function.opcode.il",
          "match": "(?<![.\\w])(?:mkrefany|refanytype|refanyval|pop|dup|nop|localloc|initblk|cpblk|cpobj|arglist|break)(?![.\\w])"
        }
      ]
    },

    "storage-modifier": {
      "patterns": [
        {
          "name": "storage.modifier.il",
          "match": "\\b(?:public|private|family|assembly|famorassem|famandassem|privatescope|compilercontrolled)\\b"
        },
        {
          "name": "storage.modifier.il",
          "match": "\\b(?:static|instance|virtual|abstract|sealed|newslot|final|hidebysig)\\b"
        },
        {
          "name": "storage.modifier.il",
          "match": "\\b(?:specialname|rtspecialname|pinvokeimpl|managed|unmanaged|cil|runtime|internalcall)\\b"
        },
        {
          "name": "storage.modifier.il",
          "match": "\\b(?:forwardref|noinlining|aggressiveinlining|synchronized)\\b"
        },
        {
          "name": "storage.modifier.il",
          "match": "\\b(?:interface|enum|extends|implements|nested|sequential|explicit|auto)\\b"
        },
        {
          "name": "storage.modifier.il",
          "match": "\\b(?:ansi|unicode|autochar|beforefieldinit|serializable|initonly|literal|notserialized|extern)\\b"
        },
        {
          "name": "storage.modifier.il",
          "match": "\\b(?:init|marshal|modopt|modreq|in|out|opt|at|bytearray|nullref|vararg|default)\\b"
        },
        {
          "name": "storage.modifier.il",
          "match": "\\b(?:pinned|strict|preservesig|nometadata|cdecl|stdcall|thiscall|fastcall|winapi)\\b"
        }
      ]
    },

    "type-builtin": {
      "name": "keyword.type.il",
      "match": "\\b(?:void|bool|char|int8|int16|int32|int64|float32|float64|native|unsigned|int|object|string|typedref|class|valuetype)\\b"
    },

    "type-builtin-ilspy": {
      "name": "keyword.type.il",
      "match": "\\b(?:uint8|uint16|uint32|uint64|uint|float|wchar|refany)\\b"
    },

    "constant-language": {
      "patterns": [
        {
          "name": "constant.language.boolean.true.il",
          "match": "\\btrue\\b"
        },
        {
          "name": "constant.language.boolean.false.il",
          "match": "\\bfalse\\b"
        },
        {
          "name": "constant.language.null.il",
          "match": "\\bnull\\b"
        }
      ]
    },

    "keyword-other": {
      "name": "keyword.other.il",
      "match": "\\b(?:to|handler|protected)\\b"
    },

    "handler": {
      "name": "keyword.control.try.il",
      "match": "(?<![.\\w])(?:catch|finally|fault|filter)(?![.\\w])"
    },

    "number-hex": {
      "name": "constant.numeric.hex.il",
      "match": "\\b0[xX][0-9a-fA-F]+\\b"
    },

    "number-float": {
      "name": "constant.numeric.float.il",
      "match": "\\b[0-9]+\\.[0-9]+(?:[eE][+-]?[0-9]+)?\\b"
    },

    "number-integer": {
      "name": "constant.numeric.integer.il",
      "match": "\\b[0-9]+\\b"
    },

    "assembly-ref": {
      "name": "entity.name.type.module.il",
      "match": "\\[[A-Za-z_][\\w.]*\\]"
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.accessor.il",
          "match": "::"
        },
        {
          "name": "punctuation.section.braces.begin.il",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.braces.end.il",
          "match": "\\}"
        }
      ]
    }
  }
}
